---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site.ts";

interface Props {
  title?: string;
  description?: string;
  topTheme?: "light" | "dark";
}

const {
  title,
  description = site.description,
  topTheme = "light",
} = Astro.props;

const pageTitle = title ? `${title} · ${site.shortName}` : site.name;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL("/images/home/1-13.jpg", site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header topTheme={topTheme} />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-reveal: progressive enhancement for [.reveal] elements
      const els = document.querySelectorAll<HTMLElement>(".reveal");
      if (els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );
        els.forEach((el) => io.observe(el));
      }

      // Dark CTA bubble: anchor the expanding circle behind the band's button.
      const bands = document.querySelectorAll<HTMLElement>(".cta-band");
      if (bands.length) {
        const place = () => {
          bands.forEach((band) => {
            const btn = band.querySelector<HTMLElement>("a");
            if (!btn) return;
            const b = band.getBoundingClientRect();
            if (!b.width || !b.height) return;
            const r = btn.getBoundingClientRect();
            const cx = r.left + r.width / 2 - b.left;
            const cy = r.top + r.height / 2 - b.top;
            // clip-path % radius reference: sqrt(w^2 + h^2) / sqrt(2)
            const ref = Math.sqrt(b.width ** 2 + b.height ** 2) / Math.SQRT2;
            // farthest corner from the button origin → radius that fully covers
            let far = 0;
            for (const [x, y] of [[0, 0], [b.width, 0], [0, b.height], [b.width, b.height]]) {
              far = Math.max(far, Math.hypot(x - cx, y - cy));
            }
            band.style.setProperty("--cta-x", ((cx / b.width) * 100).toFixed(2) + "%");
            band.style.setProperty("--cta-y", ((cy / b.height) * 100).toFixed(2) + "%");
            band.style.setProperty("--cta-r", ((far / ref) * 100 * 1.04).toFixed(2) + "%");
          });
        };
        place();
        window.addEventListener("resize", place, { passive: true });
      }
    </script>
  </body>
</html>
