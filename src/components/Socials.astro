---
import { site } from "../data/site.ts";

interface Props {
  /** Size utility for each icon button, e.g. "h-11 w-11". */
  class?: string;
  /** Visual style: "solid" ink chips, "outline" bordered, or "bare" icon-only. */
  variant?: "solid" | "outline" | "bare";
  /** Override the Instagram URL (defaults to the site handle). */
  instagram?: string;
  /** Override the Facebook URL (defaults to the site handle). */
  facebook?: string;
}
const {
  class: className = "h-11 w-11",
  variant = "outline",
  instagram = site.social.instagram,
  facebook = site.social.facebook,
} = Astro.props;

const base =
  "inline-flex items-center justify-center rounded-full transition-all hover:-translate-y-0.5";
const styles: Record<string, string> = {
  solid: "bg-ink text-paper hover:bg-ink/90",
  outline: "border border-line text-ink hover:border-ink",
  bare: "text-current hover:opacity-70",
};
const cls = `${base} ${styles[variant]} ${className}`;

const links = [
  { href: instagram, label: "Instagram" },
  { href: facebook, label: "Facebook" },
].filter((l) => l.href);
---

<div class="inline-flex items-center gap-3">
  {
    links.map((l) => (
      <a href={l.href} target="_blank" rel="noopener" aria-label={l.label} class={cls}>
        {l.label === "Instagram" ? (
          <svg viewBox="0 0 24 24" class="h-[46%] w-[46%]" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5.2" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" class="h-[52%] w-[52%]" fill="currentColor" aria-hidden="true">
            <path d="M14.5 8.5V6.9c0-.8.2-1.2 1.3-1.2h1.5V2.8C17.4 2.7 16.4 2.6 15.3 2.6c-2.4 0-4 1.4-4 4.1v1.8H8.6v3.2h2.7V21h3.2v-9.3h2.4l.4-3.2h-2.8z" />
          </svg>
        )}
      </a>
    ))
  }
</div>
