---
import { site } from "../data/site.ts";

interface Props {
  /** Size utility for each icon button, e.g. "h-11 w-11". */
  class?: string;
  /** Visual style: "solid" ink chips, "outline" bordered, or "bare" icon-only. */
  variant?: "solid" | "outline" | "bare";
  /** Override the Instagram URL (defaults to the site handle). */
  instagram?: string;
  /** Override the Facebook URL (defaults to the site handle). */
  facebook?: string;
}
const {
  class: className = "h-11 w-11",
  variant = "outline",
  instagram = site.social.instagram,
  facebook = site.social.facebook,
} = Astro.props;

const base =
  "social-link inline-flex items-center justify-center rounded-full transition-all hover:-translate-y-0.5";
const styles: Record<string, string> = {
  solid: "bg-ink text-paper hover:bg-ink/90",
  outline: "border border-line text-ink hover:border-ink",
  bare: "text-current hover:opacity-70",
};
const cls = `${base} ${styles[variant]} ${className}`;

const links = [
  { href: instagram, label: "Instagram" },
  { href: facebook, label: "Facebook" },
].filter((l) => l.href);
---

<div class="inline-flex items-center gap-3">
  {
    links.map((l) => (
      <a
        href={l.href}
        target="_blank"
        rel="noopener"
        aria-label={l.label}
        class:list={[cls, l.label === "Instagram" ? "social-ig" : "social-fb"]}
      >
        {l.label === "Instagram" ? (
          <svg viewBox="0 0 24 24" class="h-[46%] w-[46%]" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <defs>
              <linearGradient id="ig-grad" x1="0" y1="1" x2="1" y2="0">
                <stop offset="0" stop-color="#feda75" />
                <stop offset="0.25" stop-color="#fa7e1e" />
                <stop offset="0.5" stop-color="#d62976" />
                <stop offset="0.75" stop-color="#962fbf" />
                <stop offset="1" stop-color="#4f5bd5" />
              </linearGradient>
            </defs>
            <rect class="ig-shape" x="2.5" y="2.5" width="19" height="19" rx="5.2" />
            <circle class="ig-shape" cx="12" cy="12" r="4.2" />
            <circle class="ig-dot" cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" class="h-[52%] w-[52%]" fill="currentColor" aria-hidden="true">
            <path d="M14.5 8.5V6.9c0-.8.2-1.2 1.3-1.2h1.5V2.8C17.4 2.7 16.4 2.6 15.3 2.6c-2.4 0-4 1.4-4 4.1v1.8H8.6v3.2h2.7V21h3.2v-9.3h2.4l.4-3.2h-2.8z" />
          </svg>
        )}
      </a>
    ))
  }
</div>

<style>
  /* Icon "colors up" into its brand color on hover. */
  .social-fb { transition: color 0.3s ease, background-color 0.3s ease, border-color 0.3s ease, transform 0.3s ease; }
  .social-fb:hover { color: #1877f2; }
  /* Instagram: the mark switches to the Instagram gradient on hover. */
  .social-ig .ig-shape { transition: stroke 0.25s ease; }
  .social-ig:hover .ig-shape { stroke: url(#ig-grad); }
  .social-ig:hover .ig-dot { fill: url(#ig-grad); }
</style>
