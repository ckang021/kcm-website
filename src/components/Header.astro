---
import { nav } from "../data/site.ts";
import Logo from "./Logo.astro";

interface Props {
  /** "dark" = page opens with a dark hero, so nav sits white/transparent until scrolled. */
  topTheme?: "light" | "dark";
}
const { topTheme = "light" } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  data-header
  data-top-theme={topTheme}
  class="fixed inset-x-0 top-0 z-50"
>
  <div class="mx-auto max-w-7xl px-3 pt-3 sm:px-5 sm:pt-4">
   <div
    data-glass
    class="flex items-center justify-between rounded-2xl px-4 py-3 transition-[background-color,box-shadow] duration-300 sm:px-6"
   >
    <a href="/" aria-label="Kristos Campus Missions — Home" data-logo class="shrink-0">
      <Logo class="h-8" link={false} />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-nav-link
            data-active={isActive(item.href) ? "true" : "false"}
            class="text-sm font-medium tracking-tight transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:flex">
      <a
        href="/give"
        data-give
        class="rounded-full px-5 py-2 text-sm font-medium transition-transform hover:-translate-y-0.5"
      >
        Give
      </a>
    </div>

    <!-- Mobile toggle -->
    <button
      type="button"
      data-menu-toggle
      aria-label="Open menu"
      aria-expanded="false"
      class="relative z-50 flex h-10 w-10 items-center justify-center lg:hidden"
    >
      <span class="sr-only">Toggle menu</span>
      <svg data-burger class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
    </button>
   </div>
  </div>
</header>

<!-- Mobile menu overlay -->
<div
  data-menu-panel
  class="fixed inset-0 z-40 translate-x-full bg-paper transition-transform duration-300 ease-out lg:hidden"
>
  <div class="flex h-full flex-col px-6 pb-10 pt-24">
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "border-b border-line py-4 font-display text-2xl tracking-tight",
              isActive(item.href) ? "text-ink" : "text-ash",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a
      href="/give"
      class="mt-8 rounded-full bg-ink px-6 py-4 text-center text-lg font-medium text-paper"
    >
      Give
    </a>
  </div>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
  const header = document.querySelector<HTMLElement>("[data-header]");

  let open = false;
  function setMenu(next: boolean) {
    open = next;
    panel?.classList.toggle("translate-x-full", !open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.body.style.overflow = open ? "hidden" : "";
  }
  toggle?.addEventListener("click", () => setMenu(!open));
  panel?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setMenu(false))
  );

  const onScroll = () => {
    if (window.scrollY > 24) header?.setAttribute("data-scrolled", "true");
    else header?.removeAttribute("data-scrolled");
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
  /* ---------------------------------------------------------------
     Liquid-glass nav — a floating, frosted capsule that refracts the
     content behind it. The tint adapts to context: a cool, dark glass
     over a dark hero (so the white mark reads), a bright paper glass
     once scrolled onto light content. Palette vars drive both.
     --------------------------------------------------------------- */
  [data-header] {
    --glass: color-mix(in srgb, var(--color-paper) 62%, transparent);
    --edge: rgba(255, 255, 255, 0.55);
    --halo: 0 12px 34px -14px rgba(10, 10, 10, 0.30);
  }

  [data-glass] {
    background: var(--glass);
    -webkit-backdrop-filter: blur(20px) saturate(185%);
    backdrop-filter: blur(20px) saturate(185%);
    border: 1px solid color-mix(in srgb, var(--edge) 60%, transparent);
    /* bright top rim + faint inner floor + soft outer halo = glass depth */
    box-shadow:
      inset 0 1px 0 var(--edge),
      inset 0 -1px 1px rgba(255, 255, 255, 0.05),
      var(--halo);
  }

  /* Over a dark hero (before scroll): dark, cool glass so white marks pop */
  [data-header][data-top-theme="dark"]:not([data-scrolled]) {
    --glass: rgba(14, 14, 18, 0.30);
    --edge: rgba(255, 255, 255, 0.16);
    --halo: 0 12px 34px -16px rgba(0, 0, 0, 0.55);
  }

  /* --- Mark / link colours --- */
  [data-header] [data-logo] { color: var(--color-ink); }
  [data-header] [data-nav-link] { color: var(--color-ash); }
  [data-header] [data-nav-link][data-active="true"] { color: var(--color-ink); }
  [data-header] [data-nav-link]:hover { color: var(--color-ink); }
  [data-header] [data-give] { background: var(--color-ink); color: var(--color-paper); }
  [data-header] [data-burger] { color: var(--color-ink); }

  /* --- Dark top theme (over a dark hero): white until scrolled --- */
  [data-header][data-top-theme="dark"]:not([data-scrolled]) [data-logo] { color: #fff; }
  [data-header][data-top-theme="dark"]:not([data-scrolled]) [data-nav-link] { color: rgba(255,255,255,0.72); }
  [data-header][data-top-theme="dark"]:not([data-scrolled]) [data-nav-link][data-active="true"],
  [data-header][data-top-theme="dark"]:not([data-scrolled]) [data-nav-link]:hover { color: #fff; }
  [data-header][data-top-theme="dark"]:not([data-scrolled]) [data-give] { background: #fff; color: var(--color-ink); }
  [data-header][data-top-theme="dark"]:not([data-scrolled]) [data-burger] { color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    [data-glass] { transition: none; }
  }
</style>
