---
import fs from "node:fs";

// Line drawing of a team's country with a pin where the team serves.
// Drawn at build time from detailed Natural Earth outlines (public domain,
// src/data/geo/team-countries.json); falls back to the Missions map's
// low-detail world file for any country not in it.
interface Props {
  /** Country name, e.g. "India" */
  country: string;
  lat: number;
  lng: number;
  class?: string;
}
const { country, lat, lng, class: cls } = Astro.props;

type Ring = [number, number][];
const load = (path: string) => JSON.parse(fs.readFileSync(path, "utf8")).features as any[];
const byName = (list: any[]) => list.find((f) => f.properties?.name === country);
const feature =
  byName(load("src/data/geo/team-countries.json")) ?? byName(load("public/data/world.geojson"));
const allRings: Ring[] = !feature
  ? []
  : feature.geometry.type === "Polygon"
    ? feature.geometry.coordinates
    : feature.geometry.coordinates.flat();
// Drop tiny outlying islets (under 2% of the largest landmass) — they shrink
// the main shape and read as specks at badge size.
const area = (r: Ring) =>
  Math.abs(r.reduce((s, [x1, y1], i) => {
    const [x2, y2] = r[(i + 1) % r.length];
    return s + x1 * y2 - x2 * y1;
  }, 0)) / 2;
const biggest = Math.max(0, ...allRings.map(area));
const rings = allRings.filter((r) => area(r) >= biggest * 0.02);

// Simple equirectangular projection, corrected for latitude so shapes aren't stretched.
const allPts = rings.flat();
const midLat = allPts.length ? allPts.reduce((s, p) => s + p[1], 0) / allPts.length : lat;
const k = Math.cos((midLat * Math.PI) / 180);
const proj = ([x, y]: [number, number]): [number, number] => [x * k, -y];

const pts = [...allPts.map(proj), proj([lng, lat])];
const minX = Math.min(...pts.map((p) => p[0]));
const maxX = Math.max(...pts.map((p) => p[0]));
const minY = Math.min(...pts.map((p) => p[1]));
const maxY = Math.max(...pts.map((p) => p[1]));
const SIZE = 200;
const PAD = 14;
const scale = (SIZE - PAD * 2) / Math.max(maxX - minX, maxY - minY || 1);
// center the shape in the square
const offX = (SIZE - (maxX - minX) * scale) / 2;
const offY = (SIZE - (maxY - minY) * scale) / 2;
const toSvg = (p: [number, number]) => {
  const [x, y] = proj(p);
  return [(x - minX) * scale + offX, (y - minY) * scale + offY].map((n) => n.toFixed(1));
};
const d = rings.map((r) => "M" + r.map((p) => toSvg(p).join(",")).join("L") + "Z").join("");
const [pinX, pinY] = toSvg([lng, lat]);
---

{
  d && (
    <svg viewBox={`0 0 ${SIZE} ${SIZE}`} class:list={["country-shape", cls]} role="img" aria-label={`Map of ${country}`}>
      <path d={d} />
      <circle class="country-pulse" cx={pinX} cy={pinY} r="5" />
      <circle class="country-pin" cx={pinX} cy={pinY} r="5" />
    </svg>
  )
}

<style>
  .country-shape {
    overflow: visible;
  }
  .country-shape path {
    fill: rgba(255, 255, 255, 0.07);
    stroke: rgba(255, 255, 255, 0.75);
    stroke-width: 1.4;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.25));
  }
  .country-pin {
    fill: #fff;
    stroke: var(--color-ink);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .country-pulse {
    fill: rgba(255, 255, 255, 0.5);
    transform-box: fill-box;
    transform-origin: center;
    animation: country-pulse 2.4s ease-out infinite;
  }
  @keyframes country-pulse {
    from { transform: scale(1); opacity: 0.8; }
    to { transform: scale(4.5); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .country-pulse { animation: none; opacity: 0; }
  }
</style>
