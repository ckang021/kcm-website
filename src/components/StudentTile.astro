---
import { yearLabel, type Student } from "../data/testimonies.ts";

// Portrait tile for a team member — sits on the dark glass panels.
// (Not clickable yet: testimony pages come later.)
interface Props {
  student: Student;
}
const { student: s } = Astro.props;
const initials = s.name
  .split(" ")
  .filter(Boolean)
  .map((w) => w[0])
  .slice(0, 2)
  .join("")
  .toUpperCase();
---

<div class="text-center">
  <div class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-white/5 ring-1 ring-white/10">
    {
      s.photo ? (
        <img src={s.photo} alt={s.name} loading="lazy" class="h-full w-full object-cover" />
      ) : (
        <span class="grid h-full w-full place-items-center font-display text-2xl font-bold text-white/40">{initials}</span>
      )
    }
    {s.role && (
      <span class="glass-chip absolute bottom-2 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full px-2.5 py-1 text-[11px] font-medium text-white">
        {s.role}
      </span>
    )}
  </div>
  <p class="mt-2.5 text-[13px] font-medium leading-tight text-white sm:mt-3 sm:text-sm">{s.name}</p>
  {s.school && (
    <p class="mt-0.5 text-[11px] leading-snug text-white/50 sm:text-xs">
      {s.school}
      {s.year && <span class="hidden sm:inline"> · {yearLabel(s.year)}</span>}
    </p>
  )}
</div>
