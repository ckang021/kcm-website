---
interface Props {
  image: string;
  alt: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  /** min-height utility class, e.g. "min-h-[70vh]" */
  minH?: string;
  /** CSS color the image bleeds into at the bottom (should match the next section's bg) */
  bleed?: string;
}
const {
  image,
  alt,
  eyebrow,
  title,
  intro,
  minH = "min-h-[70vh]",
  bleed = "var(--color-paper)",
} = Astro.props;
---

<section class:list={["relative flex items-end overflow-hidden", minH]}>
  <img
    src={image}
    alt={alt}
    class="absolute inset-0 h-full w-full object-cover"
    fetchpriority="high"
  />

  <!-- readability overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/35 to-ink/15"></div>

  <!-- glossy bleed: image melts into the page below -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-40 sm:h-56"
    style={`background:linear-gradient(to bottom, rgba(0,0,0,0) 0%, ${bleed} 78%, ${bleed} 100%)`}
  >
  </div>
  <!-- subtle sheen just above the bleed line -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-40 h-24 opacity-60 sm:bottom-56"
    style="background:linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(255,255,255,0.06) 100%)"
  >
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-5 pb-28 pt-40 sm:px-8 sm:pb-40">
    {eyebrow && <p class="eyebrow text-white/70">{eyebrow}</p>}
    <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-white sm:text-6xl">
      {title}
    </h1>
    {intro && <p class="mt-5 max-w-xl text-lg text-white/85">{intro}</p>}
    <slot />
  </div>
</section>
