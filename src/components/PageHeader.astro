---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="border-b border-line bg-paper pt-32">
  <div class="mx-auto max-w-7xl px-5 pb-16 sm:px-8 sm:pb-20">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-4 max-w-4xl font-display text-4xl font-bold leading-[1.05] tracking-tight sm:text-6xl">
      {title}
    </h1>
    {intro && <p class="mt-6 max-w-2xl text-lg text-ash">{intro}</p>}
  </div>
</section>
