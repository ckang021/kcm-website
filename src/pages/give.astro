---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Give" description="Support Kristos Campus Missions with an offering or gift.">
  <section class="cta-band relative flex min-h-[80vh] items-center overflow-hidden bg-ink text-paper">
    <img
      src="/images/give/partner.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/75 to-ink/80"></div>
    <div class="cta-bubble" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-3xl px-5 py-32 text-center sm:px-8">
      <p class="eyebrow text-white/50">Give</p>
      <h1 class="mt-5 font-display text-4xl font-bold leading-tight tracking-tight sm:text-6xl">
        Partner with the mission.
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-white/70">
        If you're interested in sending an offering or giving to KCM, follow the link below for instructions.
      </p>
      <a
        href="/SupportKCM.pdf"
        target="_blank"
        rel="noopener"
        class="mt-10 inline-block rounded-full bg-white px-8 py-4 text-sm font-medium text-ink transition-transform hover:-translate-y-0.5"
      >
        Give Here →
      </a>
      <p class="mt-6 text-xs text-white/40">Opens giving instructions (PDF)</p>
    </div>
  </section>
</Layout>
