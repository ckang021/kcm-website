---
import Layout from "../layouts/Layout.astro";
import { site, resources } from "../data/site.ts";
import { campuses } from "../data/campuses.ts";
import { teams } from "../data/missions.ts";

const gallery = Array.from({ length: 12 }, (_, i) =>
  i === 0 ? "/images/home/image-asset.jpg" : `/images/home/image-asset-${i + 1}.jpg`
);
---

<Layout topTheme="dark">
  <!-- HERO -->
  <section class="relative flex min-h-[92vh] items-end overflow-hidden bg-ink">
    <video
      class="absolute inset-0 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/videos/home-hero-poster.jpg"
      aria-hidden="true"
    >
      <source src="/videos/home-hero-web.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/40 to-ink/30"></div>
    <!-- soft seam into the page below -->
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-20 sm:h-28"
      style="background:linear-gradient(to bottom, rgba(0,0,0,0) 0%, var(--color-paper) 96%)"
    >
    </div>
    <div class="relative mx-auto w-full max-w-7xl px-5 pb-24 pt-40 sm:px-8 sm:pb-32">
      <p class="eyebrow text-white/70">Kristos Campus Missions</p>
      <h1 class="mt-5 max-w-4xl font-display text-4xl font-bold leading-[1.04] tracking-tight text-white sm:text-6xl lg:text-7xl">
        Discipling collegians for the mission of God.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-white/80">{site.mission}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/about" class="rounded-full bg-white px-6 py-3 text-sm font-medium text-ink transition-transform hover:-translate-y-0.5">
          About KCM
        </a>
        <a href="/campuses" class="rounded-full border border-white/40 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-white/10">
          Find your campus
        </a>
      </div>
    </div>
  </section>

  <!-- MISSION STATEMENT -->
  <section class="border-b border-line bg-paper">
    <div class="mx-auto max-w-5xl px-5 py-24 text-center sm:px-8 sm:py-32">
      <p class="eyebrow reveal">Our heartbeat</p>
      <p class="reveal mt-8 font-display text-2xl font-medium leading-snug tracking-tight sm:text-4xl sm:leading-[1.25]">
        {site.description}
      </p>
    </div>
  </section>

  <!-- CAMPUSES STRIP -->
  <section class="relative overflow-hidden border-b border-line bg-ink py-20 text-paper">
    <!-- ambient tint: blurred photo of the hovered campus washes into the background -->
    <div id="campus-bg" class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-700 ease-out">
      <img id="campus-bg-img" src="" alt="" class="h-full w-full scale-125 object-cover" style="filter: blur(52px) brightness(0.42) saturate(1.25);" />
      <div class="absolute inset-0 bg-ink/55"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-7xl px-5 sm:px-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow text-white/50">Across SoCal</p>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
            8 campuses, one mission.
          </h2>
        </div>
        <a href="/campuses" class="group inline-flex items-center gap-1.5 text-sm text-white/70 transition-colors hover:text-white">
          Explore all campuses
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
      </div>

      <div id="campus-list" class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-2">
        {
          campuses.map((c, i) => (
            <a
              href={`/campuses#${c.slug}`}
              data-img={c.group}
              data-name={c.name}
              class="campus-name group relative inline-flex items-baseline font-display text-4xl font-bold tracking-tight sm:text-6xl"
            >
              <span class="mr-2 font-sans text-xs font-medium tabular-nums text-white/30 transition-colors group-hover:text-white/60">
                0{i + 1}
              </span>
              <span class="campus-label inline-block transition-transform duration-300 ease-out group-hover:translate-x-1">
                {c.name}
              </span>
              <span class="ml-1 inline-block -translate-x-2 text-2xl opacity-0 transition-all duration-300 ease-out group-hover:translate-x-0 group-hover:opacity-100">
                ↗
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- cursor-following campus preview -->
    <div
      id="campus-preview"
      class="pointer-events-none fixed left-0 top-0 z-40 hidden h-60 w-80 -translate-y-1/2 overflow-hidden rounded-2xl opacity-0 shadow-2xl ring-1 ring-white/15 transition-[opacity,transform] duration-200 ease-out will-change-transform"
    >
      <img id="campus-preview-img" src="" alt="" class="h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent"></div>
      <span id="campus-preview-label" class="absolute bottom-4 left-5 font-display text-xl font-bold tracking-tight text-white"></span>
    </div>
  </section>

  <style>
    /* dim the whole list on hover, spotlight the hovered name */
    #campus-list .campus-name .campus-label { color: rgba(255, 255, 255, 0.42); transition: color 0.3s ease; }
    #campus-list:hover .campus-name .campus-label { color: rgba(255, 255, 255, 0.22); }
    #campus-list .campus-name:hover .campus-label { color: #ffffff; }
    @media (prefers-reduced-motion: reduce) {
      #campus-preview { transition: opacity 0.2s ease; }
    }
  </style>

  <script>
    const list = document.getElementById("campus-list");
    const preview = document.getElementById("campus-preview");
    const previewImg = document.getElementById("campus-preview-img") as HTMLImageElement | null;
    const previewLabel = document.getElementById("campus-preview-label");
    const bg = document.getElementById("campus-bg");
    const bgImg = document.getElementById("campus-bg-img") as HTMLImageElement | null;
    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    if (list && preview && previewImg && previewLabel && bg && bgImg && canHover) {
      const links = list.querySelectorAll<HTMLAnchorElement>("a[data-img]");
      let visible = false;

      const place = (e: MouseEvent) => {
        const w = preview.offsetWidth;
        const h = preview.offsetHeight;
        const pad = 24;
        const edge = 12;
        // prefer the right of the cursor; flip left if it would overflow
        let x = e.clientX + pad;
        if (x + w > window.innerWidth - edge) x = e.clientX - w - pad;
        x = Math.max(edge, Math.min(x, window.innerWidth - w - edge));
        // vertically centered on the cursor, kept fully on-screen
        const y = Math.max(h / 2 + edge, Math.min(e.clientY, window.innerHeight - h / 2 - edge));
        preview.style.left = `${x}px`;
        preview.style.top = `${y}px`;
      };

      const show = (a: HTMLAnchorElement, e: MouseEvent) => {
        const src = a.dataset.img || "";
        previewImg.src = src;
        previewLabel.textContent = a.dataset.name || "";
        // ambient tint background
        if (bgImg.getAttribute("src") !== src) bgImg.src = src;
        bg.style.opacity = "1";
        // cursor card
        preview.classList.remove("hidden");
        place(e);
        void preview.offsetWidth; // force reflow so the transition runs
        preview.style.opacity = "1";
        preview.style.transform = "translateY(-50%) scale(1)";
        visible = true;
      };

      const hide = () => {
        preview.style.opacity = "0";
        preview.style.transform = "translateY(-50%) scale(0.96)";
        bg.style.opacity = "0";
        visible = false;
      };

      // update on each name; hide only when leaving the whole list (no flicker between names)
      links.forEach((a) => {
        a.addEventListener("mouseenter", (e) => show(a, e));
      });
      list.addEventListener("mouseleave", hide);
      list.addEventListener("mousemove", (e) => {
        if (visible) place(e);
      });
      preview.addEventListener("transitionend", () => {
        if (!visible) preview.classList.add("hidden");
      });
    }
  </script>

  <!-- EVENT PHOTOS -->
  <section class="border-b border-line bg-paper py-24 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="flex items-end justify-between">
        <div>
          <p class="eyebrow reveal">Life together</p>
          <h2 class="reveal mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">Event photos</h2>
        </div>
      </div>
      <div class="mt-10 columns-2 gap-4 md:columns-3 lg:columns-4 [&>*]:mb-4">
        {
          gallery.map((src, i) => (
            <img
              src={src}
              alt="KCM event"
              loading="lazy"
              class="reveal w-full rounded-lg object-cover"
              style={`transition-delay:${(i % 4) * 60}ms`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- MISSIONS TEASER -->
  <section class="relative overflow-hidden border-b border-line bg-ink py-24 text-paper sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="eyebrow text-white/50 reveal">STSM 2025 · #go</p>
          <h2 class="reveal mt-3 max-w-md font-display text-3xl font-bold leading-tight tracking-tight sm:text-5xl">
            Sending students to the ends of the earth.
          </h2>
          <p class="reveal mt-6 max-w-md text-white/70">
            Every year KCM sends teams around the world to support missionaries and partake in the Great Commission.
          </p>
          <a href="/missions" class="reveal mt-8 inline-block rounded-full bg-white px-6 py-3 text-sm font-medium text-ink transition-transform hover:-translate-y-0.5">
            See our teams
          </a>
        </div>
        <div class="grid grid-cols-3 gap-3">
          {
            teams.map((t) => (
              <a href={`/missions#${t.slug}`} class="group relative aspect-[3/4] overflow-hidden rounded-lg">
                <img src={t.cover} alt={t.country} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-ink/80 to-transparent"></div>
                <span class="absolute bottom-2 left-2.5 text-xs font-medium tracking-tight text-white">{t.country}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- RESOURCES / APPS -->
  <section class="border-b border-line bg-bone py-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="grid gap-4 sm:grid-cols-2">
        {
          resources.map((r) => (
            <a
              href={r.href}
              target="_blank"
              rel="noopener"
              class="reveal group flex items-center justify-between rounded-2xl border border-line bg-paper p-7 transition-colors hover:border-ink"
            >
              <div>
                <p class="font-display text-xl font-bold tracking-tight">{r.label}</p>
                <p class="mt-1 text-sm text-ash">{r.note}</p>
              </div>
              <span class="text-2xl text-ash transition-transform group-hover:translate-x-1 group-hover:text-ink">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- INSTAGRAM / GIVE CTA -->
  <section class="bg-paper py-24 text-center sm:py-28">
    <div class="mx-auto max-w-2xl px-5 sm:px-8">
      <p class="eyebrow reveal">Stay connected</p>
      <h2 class="reveal mt-4 font-display text-3xl font-bold tracking-tight sm:text-4xl">
        Check us out on Instagram
      </h2>
      <p class="reveal mt-3 text-ash">Follow {site.social.instagramHandle} for the latest from KCM.</p>
      <div class="reveal mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.social.instagram} target="_blank" rel="noopener" class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-paper transition-transform hover:-translate-y-0.5">
          @kcm.network
        </a>
        <a href="/give" class="rounded-full border border-line px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-ink">
          Support KCM
        </a>
      </div>
    </div>
  </section>
</Layout>
