---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { site, about } from "../data/site.ts";
---

<Layout title="About" description={site.mission} topTheme="dark">
  <Hero
    image="/images/about/1-28.jpg"
    alt="KCM students in worship"
    eyebrow="About KCM"
    title={about.lead}
    intro={about.sub}
  />

  <!-- Mission statement -->
  <section class="bg-oatmeal">
    <div class="mx-auto max-w-4xl px-5 py-24 text-center sm:px-8 sm:py-32">
      <p class="eyebrow reveal">Our mission</p>
      <p class="reveal mt-8 font-display text-2xl font-medium leading-snug tracking-tight sm:text-4xl sm:leading-[1.25]">
        {site.mission}
      </p>
    </div>
  </section>

  <!-- Purpose -->
  <section class="border-t border-line bg-bone py-24 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="grid gap-2 md:grid-cols-[280px_1fr] md:gap-16">
        <div>
          <h2 class="sticky top-28 font-display text-3xl font-bold tracking-tight sm:text-4xl">Purpose</h2>
        </div>
        <div class="divide-y divide-line">
          {
            about.purpose.map((p) => (
              <div class="reveal py-8 first:pt-0">
                <h3 class="font-display text-xl font-semibold tracking-tight">{p.q}</h3>
                <p class="mt-3 max-w-2xl leading-relaxed text-ash">{p.a}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="group relative overflow-hidden bg-ink py-20 text-paper">
    <!-- warm wash slides across the entire black background on hover;
         feathered leading edge so it fades in naturally (no hard vertical line) -->
    <div
      class="pointer-events-none absolute inset-y-0 left-0 w-[160%] -translate-x-full transition-transform duration-[800ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-0 motion-reduce:hidden"
      style="background:linear-gradient(to right, #2b2620 0%, #2b2620 66%, rgba(43,38,32,0) 100%)"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 sm:flex-row sm:items-center sm:px-8">
      <h2 class="max-w-md font-display text-2xl font-bold tracking-tight sm:text-3xl">
        We're spread across 8 SoCal campuses.
      </h2>
      <a
        href="/campuses"
        class="inline-flex shrink-0 items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-medium text-ink transition-transform duration-300 hover:-translate-y-0.5"
      >
        <span>Check out our campuses</span>
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>
  </section>
</Layout>
