---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { site, about } from "../data/site.ts";
---

<Layout title="About" description={site.mission} topTheme="dark">
  <Hero
    image="/images/about/1-28.jpg"
    alt="KCM students in worship"
    eyebrow="About KCM"
    title={about.lead}
    intro={about.sub}
  />

  <!-- Mission statement -->
  <section class="bg-paper">
    <div class="mx-auto max-w-4xl px-5 py-24 text-center sm:px-8 sm:py-32">
      <p class="eyebrow reveal">Our mission</p>
      <p class="reveal mt-8 font-display text-2xl font-medium leading-snug tracking-tight sm:text-4xl sm:leading-[1.25]">
        {site.mission}
      </p>
    </div>
  </section>

  <!-- Purpose -->
  <section class="border-t border-line bg-bone py-24 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="grid gap-2 md:grid-cols-[280px_1fr] md:gap-16">
        <div>
          <h2 class="sticky top-28 font-display text-3xl font-bold tracking-tight sm:text-4xl">Purpose</h2>
        </div>
        <div class="divide-y divide-line">
          {
            about.purpose.map((p) => (
              <div class="reveal py-8 first:pt-0">
                <h3 class="font-display text-xl font-semibold tracking-tight">{p.q}</h3>
                <p class="mt-3 max-w-2xl leading-relaxed text-ash">{p.a}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-ink py-20 text-paper">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 sm:flex-row sm:items-center sm:px-8">
      <h2 class="max-w-md font-display text-2xl font-bold tracking-tight sm:text-3xl">
        We're spread across 8 SoCal campuses.
      </h2>
      <a
        href="/campuses"
        class="group relative inline-flex shrink-0 items-center gap-2 overflow-hidden rounded-full bg-white px-6 py-3 text-sm font-medium text-ink ring-1 ring-white/70 transition-colors duration-300 hover:text-white"
      >
        <span
          class="absolute inset-0 -translate-x-full bg-ink transition-transform duration-300 ease-out group-hover:translate-x-0"
          aria-hidden="true"
        ></span>
        <span class="relative z-10">Check out our campuses</span>
        <span class="relative z-10 transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>
  </section>
</Layout>
