---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Socials from "../components/Socials.astro";
import { campuses } from "../data/campuses.ts";
---

<Layout title="Campuses" description="KCM exists on 8 college campuses across Southern California." topTheme="dark">
  <Hero
    image="/images/campuses/1-4.jpg"
    alt="KCM campus community"
    eyebrow="Our Campuses"
    title="KCM exists on 8 college campuses across Southern California."
    bleed="var(--color-paper)"
  />

  <!-- Sticky campus tabs — floating liquid-glass capsule with a sliding pill -->
  <section data-tabs class="sticky top-[84px] z-30">
    <div class="mx-auto max-w-7xl px-4 py-3 sm:px-6">
      <div data-tabs-glass class="w-fit max-w-full overflow-x-auto rounded-2xl">
        <div data-tabs-track class="relative flex w-max gap-x-1 p-1.5">
          {
            campuses.map((c) => (
              <a
                href={`#${c.slug}`}
                data-tab={c.slug}
                class="relative z-10 whitespace-nowrap rounded-full px-4 py-2 text-base font-semibold tracking-tight text-ash transition-colors duration-300 hover:text-ink"
              >
                {c.name}
              </a>
            ))
          }
          <!-- sliding glass pill -->
          <span
            data-tabs-indicator
            class="pointer-events-none absolute left-0 top-0 rounded-full bg-ink opacity-0"
          ></span>
        </div>
      </div>
    </div>
  </section>

  {
    campuses.map((c, idx) => (
      <section id={c.slug} class="scroll-mt-[150px] border-b border-line py-20 sm:py-24" class:list={[idx % 2 === 1 ? "bg-bone" : "bg-paper"]}>
        <div class="mx-auto max-w-7xl px-5 sm:px-8">
          <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-start lg:gap-16">
            <div>
              <p class="eyebrow">{c.city}</p>
              <h2 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">{c.name}</h2>
              <p class="mt-2 text-ash">{c.full}</p>
              <div class="mt-5">
                <Socials class="h-10 w-10" variant="outline" instagram={c.instagram} facebook={c.facebook} />
              </div>
              <img src={c.group} alt={`${c.name} KCM group`} loading="lazy" class="reveal mt-8 aspect-[4/3] w-full rounded-2xl object-cover" />
            </div>

            <div>
              <div class="flex items-baseline justify-between border-b border-line pb-4">
                <p class="eyebrow">Cores</p>
                <p class="text-sm text-ash">{c.cores.length} {c.cores.length === 1 ? "leader" : "leaders"}</p>
              </div>
              <div class="mt-8 grid grid-cols-2 gap-x-5 gap-y-9 sm:grid-cols-3">
                {c.cores.map((m) => (
                  <div class="core-card reveal group">
                    <div class="photo-frame aspect-[4/5] overflow-hidden rounded-2xl bg-bone">
                      <img src={m.photo} alt={m.name} loading="lazy" class="core-photo h-full w-full object-cover" />
                    </div>
                    <p class="mt-3 font-medium leading-tight tracking-tight transition-colors group-hover:text-ink">{m.name}</p>
                    <p class="text-sm text-ash">{m.role}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <style>
    /* Floating liquid-glass capsule (cohesive with the main nav) */
    [data-tabs-glass] {
      background: color-mix(in srgb, var(--color-paper) 60%, transparent);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.6),
        0 10px 30px -14px rgba(10, 10, 10, 0.32);
    }
    /* Active tab text sits on the dark pill */
    [data-tab][data-active="true"] { color: var(--color-paper); }
    /* The pill glides sideways to the active tab */
    [data-tabs-indicator] {
      transition:
        transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
        width 0.5s cubic-bezier(0.22, 1, 0.36, 1),
        height 0.5s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.3s ease;
    }
    @media (prefers-reduced-motion: reduce) {
      [data-tabs-indicator] { transition: opacity 0.3s ease; }
    }

    /* Core portraits: full colour, gentle float on hover (cohesive with Staff) */
    .photo-frame {
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .core-card:hover .photo-frame {
      transform: translateY(-8px);
      box-shadow: 0 22px 45px -14px rgba(0, 0, 0, 0.4);
    }
    @media (prefers-reduced-motion: reduce) {
      .photo-frame,
      .core-card:hover .photo-frame { transform: none; transition: box-shadow 0.3s ease; }
    }
  </style>

  <script>
    const track = document.querySelector<HTMLElement>("[data-tabs-track]");
    const indicator = document.querySelector<HTMLElement>("[data-tabs-indicator]");
    const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-tab]"));
    const sections = tabs
      .map((t) => document.getElementById(t.dataset.tab || ""))
      .filter((el): el is HTMLElement => !!el);

    if (track && indicator && tabs.length) {
      const moveTo = (tab: HTMLAnchorElement) => {
        indicator.style.opacity = "1";
        indicator.style.width = `${tab.offsetWidth}px`;
        indicator.style.height = `${tab.offsetHeight}px`;
        indicator.style.transform = `translate(${tab.offsetLeft}px, ${tab.offsetTop}px)`;
      };

      const setActive = (slug: string) => {
        const tab = tabs.find((t) => t.dataset.tab === slug);
        if (!tab) return;
        tabs.forEach((t) => t.setAttribute("data-active", String(t === tab)));
        moveTo(tab);
        // keep the active tab visible in the horizontal scroller
        const left = tab.offsetLeft - track.clientWidth / 2 + tab.offsetWidth / 2;
        track.scrollTo({ left, behavior: "smooth" });
      };

      // scroll-spy: whichever section is closest to the top band wins
      const io = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible?.target.id) setActive(visible.target.id);
        },
        { rootMargin: "-45% 0px -45% 0px", threshold: [0, 0.25, 0.5, 1] }
      );
      sections.forEach((s) => io.observe(s));

      // click: let the hash jump happen, then snap the indicator
      tabs.forEach((t) =>
        t.addEventListener("click", () => setActive(t.dataset.tab || ""))
      );
      // recompute on resize
      window.addEventListener("resize", () => {
        const active = tabs.find((t) => t.getAttribute("data-active") === "true");
        if (active) moveTo(active);
      });
      // initial
      if (sections[0]) setActive(sections[0].id);
    }
  </script>
</Layout>
