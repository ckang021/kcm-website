---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { campuses } from "../data/campuses.ts";
---

<Layout title="Campuses" description="KCM exists on 8 college campuses across Southern California." topTheme="dark">
  <Hero
    image="/images/campuses/1-4.jpg"
    alt="KCM campus community"
    eyebrow="Our Campuses"
    title="KCM exists on 8 college campuses across Southern California."
  />

  <!-- Quick index -->
  <section class="sticky top-0 z-30 border-b border-line bg-paper/90 backdrop-blur">
    <div class="mx-auto flex max-w-7xl gap-x-6 gap-y-2 overflow-x-auto px-5 py-3 sm:px-8">
      {
        campuses.map((c) => (
          <a href={`#${c.slug}`} class="whitespace-nowrap text-sm font-medium text-ash transition-colors hover:text-ink">
            {c.name}
          </a>
        ))
      }
    </div>
  </section>

  {
    campuses.map((c, idx) => (
      <section id={c.slug} class="scroll-mt-16 border-b border-line py-20 sm:py-24" class:list={[idx % 2 === 1 ? "bg-bone" : "bg-paper"]}>
        <div class="mx-auto max-w-7xl px-5 sm:px-8">
          <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-start lg:gap-16">
            <div class="lg:sticky lg:top-24">
              <p class="eyebrow">{c.city}</p>
              <h2 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">{c.name}</h2>
              <p class="mt-2 text-ash">{c.full}</p>
              <div class="mt-5 flex gap-3">
                <a href={c.instagram} target="_blank" rel="noopener" class="rounded-full border border-line px-4 py-2 text-sm font-medium transition-colors hover:border-ink">
                  Instagram
                </a>
                {c.facebook && (
                  <a href={c.facebook} target="_blank" rel="noopener" class="rounded-full border border-line px-4 py-2 text-sm font-medium transition-colors hover:border-ink">
                    Facebook
                  </a>
                )}
              </div>
              <img src={c.group} alt={`${c.name} KCM group`} loading="lazy" class="reveal mt-8 aspect-[4/3] w-full rounded-2xl object-cover" />
            </div>

            <div>
              <p class="eyebrow mb-6">Cores</p>
              <div class="grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-3">
                {c.cores.map((m) => (
                  <div class="reveal">
                    <div class="aspect-square overflow-hidden rounded-xl bg-bone">
                      <img src={m.photo} alt={m.name} loading="lazy" class="h-full w-full object-cover" />
                    </div>
                    <p class="mt-3 font-medium leading-tight tracking-tight">{m.name}</p>
                    <p class="text-sm text-ash">{m.role}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }
</Layout>
