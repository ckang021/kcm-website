---
import Layout from "../layouts/Layout.astro";
import { missionsIntro, teams } from "../data/missions.ts";
---

<Layout title="Missions" description={missionsIntro.body} topTheme="dark">
  <!-- Hero -->
  <section class="relative flex min-h-[70vh] items-end overflow-hidden">
    <img src={missionsIntro.hero} alt="KCM missions" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/50 to-ink/30"></div>
    <!-- soft seam into the page below -->
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-20 sm:h-28"
      style="background:linear-gradient(to bottom, rgba(0,0,0,0) 0%, var(--color-fade) 96%)"
    >
    </div>
    <div class="relative mx-auto w-full max-w-7xl px-5 pb-24 pt-40 sm:px-8 sm:pb-28">
      <p class="max-w-4xl font-display text-3xl font-bold leading-[1.12] tracking-tight text-white sm:text-5xl lg:text-6xl">
        &ldquo;{missionsIntro.verse}&rdquo;
      </p>
      <p class="mt-6 text-sm font-medium uppercase tracking-[0.2em] text-white/70">{missionsIntro.reference}</p>
    </div>
  </section>

  <!-- Program -->
  <section class="fade-dark py-24 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="grid gap-8 lg:grid-cols-[280px_1fr] lg:gap-16">
        <div>
          <p class="eyebrow">{missionsIntro.season}</p>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">{missionsIntro.heading}</h2>
        </div>
        <div>
          <p class="max-w-2xl text-lg leading-relaxed text-white/70">{missionsIntro.body}</p>
          <p class="mt-8 font-display text-6xl font-bold tracking-tight text-white/10">{missionsIntro.hashtag}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Reach map -->
  <section class="fade-dark pb-24 sm:pb-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="eyebrow">Where we're going</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">Sending to the nations</h2>
      <div
        id="missions-map"
        class="mt-10 h-[420px] w-full overflow-hidden rounded-2xl ring-1 ring-white/10 sm:h-[520px]"
        role="img"
        aria-label="World map showing the general locations of KCM's 2026 mission teams"
      >
      </div>
      <p class="mt-4 text-sm text-white/45">General locations of KCM's 2026 Short-Term Summer Missions teams.</p>
    </div>
  </section>

  <script type="application/json" id="teams-data" set:html={JSON.stringify(
    teams.map((t) => ({ country: t.country, region: t.region, lat: t.lat, lng: t.lng, cover: t.cover }))
  )} />

  <script>
    import L from "leaflet";
    import "leaflet/dist/leaflet.css";

    type Team = {
      country: string;
      region: string;
      lat: number;
      lng: number;
      cover: string;
    };
    const teams: Team[] = JSON.parse(
      document.getElementById("teams-data")!.textContent || "[]"
    );
    const el = document.getElementById("missions-map");

    if (el && teams.length) {
      // A generic, static world graphic — no tiles, no panning/zooming.
      const map = L.map(el, {
        zoomControl: false,
        attributionControl: false,
        dragging: false,
        scrollWheelZoom: false,
        doubleClickZoom: false,
        boxZoom: false,
        keyboard: false,
        touchZoom: false,
      });
      map.setView([16, 55], 2); // fallback until the first real fit

      const pin = L.divIcon({
        className: "kcm-mpin",
        html: "<span></span>",
        iconSize: [16, 16],
        iconAnchor: [8, 8],
      });

      const pts: [number, number][] = [];
      teams.forEach((t) => {
        if (t.lat == null || t.lng == null) return;
        const m = L.marker([t.lat, t.lng], { icon: pin, riseOnHover: true }).addTo(map);
        // Pin carries the country name as a permanent label…
        m.bindTooltip(t.country, {
          permanent: true,
          direction: "bottom",
          offset: [0, 7],
          className: "pin-label",
        });
        // …and reveals that team's photo on hover.
        m.bindPopup(
          `<figure class="team-card"><img src="${t.cover}" alt="${t.country}" /><figcaption>${t.country}</figcaption></figure>`,
          { closeButton: false, autoPan: false, offset: [0, -4], className: "team-popup" }
        );
        m.on("mouseover", () => m.openPopup());
        m.on("mouseout", () => m.closePopup());
        pts.push([t.lat, t.lng]);
      });

      // Frame all teams. The box can report 0 width on first paint, which makes
      // fitBounds pick a too-close zoom — so refit once it has a real width.
      const fit = () => {
        if (pts.length && el.clientWidth > 40) {
          map.fitBounds(pts, { padding: [26, 46], maxZoom: 4 });
        }
      };

      // Generic monochrome basemap drawn from local world GeoJSON (no keys).
      fetch("/data/world.geojson")
        .then((r) => r.json())
        .then((geo) => {
          L.geoJSON(geo, {
            interactive: false,
            style: {
              color: "#3a3a42",
              weight: 0.6,
              fillColor: "#2a2a30",
              fillOpacity: 1,
            },
          })
            .addTo(map)
            .bringToBack();
          fit();
        })
        .catch(() => fit());

      fit();
      let lastW = 0;
      const remeasure = () => {
        map.invalidateSize();
        const w = el.clientWidth;
        if (w > 0 && Math.abs(w - lastW) > 4) {
          lastW = w;
          fit();
        }
      };
      if ("ResizeObserver" in window) new ResizeObserver(remeasure).observe(el);
      window.addEventListener("resize", remeasure);
      setTimeout(remeasure, 300);
    }
  </script>

  <style is:global>
    #missions-map .leaflet-container {
      background: #131316; /* "ocean" behind the land shapes */
      font-family: var(--font-sans, sans-serif);
      cursor: default;
    }
    .kcm-mpin {
      cursor: pointer;
    }
    .kcm-mpin span {
      display: block;
      width: 13px;
      height: 13px;
      border-radius: 9999px;
      background: #fff;
      border: 2px solid #0a0a0a;
      box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.14), 0 1px 6px rgba(0, 0, 0, 0.6);
      transition: transform 0.15s ease;
    }
    .kcm-mpin:hover span {
      transform: scale(1.25);
    }

    /* Permanent country label under each pin */
    .leaflet-tooltip.pin-label {
      background: transparent;
      border: none;
      box-shadow: none;
      padding: 0;
      color: rgba(255, 255, 255, 0.85);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      white-space: nowrap;
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95);
    }
    .leaflet-tooltip.pin-label::before {
      display: none;
    }

    /* Hover card showing the team's photo */
    .team-popup .leaflet-popup-content-wrapper {
      padding: 0;
      overflow: hidden;
      border-radius: 14px;
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.55);
    }
    .team-popup .leaflet-popup-content {
      margin: 0;
      width: 200px !important;
    }
    .team-popup .leaflet-popup-tip {
      background: #fff;
    }
    .team-card {
      margin: 0;
    }
    .team-card img {
      display: block;
      width: 100%;
      height: 120px;
      object-fit: cover;
    }
    .team-card figcaption {
      padding: 9px 13px;
      font-family: var(--font-display, sans-serif);
      font-weight: 600;
      font-size: 0.95rem;
      color: #0a0a0a;
    }
  </style>

  <!-- Teams board -->
  <section class="border-b border-line bg-ink py-24 text-paper sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="eyebrow text-white/50">2026 STSM Teams</p>
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          teams.map((t) => (
            <div class="group relative aspect-[3/2] overflow-hidden rounded-2xl">
              <img src={t.cover} alt={t.country} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/20 to-transparent"></div>
              <div class="absolute bottom-0 left-0 p-5">
                <p class="text-xs uppercase tracking-[0.2em] text-white/60">{t.region}</p>
                <p class="font-display text-2xl font-bold tracking-tight text-white">{t.country}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Give CTA -->
  <section class="cta-band relative overflow-hidden bg-ink py-20 text-center text-paper">
    <div class="cta-bubble" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-xl px-5 sm:px-8">
      <h2 class="font-display text-6xl font-bold tracking-tight text-white/10 sm:text-7xl">#send</h2>
      <p class="mt-6 text-white/70">Partner with KCM to send collegians to the nations.</p>
      <a href="/give" class="mt-7 inline-block rounded-full bg-white px-6 py-3 text-sm font-medium text-ink transition-all duration-300 hover:-translate-y-0.5 hover:bg-neutral-200">
        Give to KCM
      </a>
    </div>
  </section>

</Layout>
