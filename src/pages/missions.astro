---
import Layout from "../layouts/Layout.astro";
import { missionsIntro, teams } from "../data/missions.ts";
---

<Layout title="Missions" description={missionsIntro.body} topTheme="dark">
  <!-- Hero -->
  <section class="relative flex min-h-[70vh] items-end overflow-hidden">
    <img src={missionsIntro.hero} alt="KCM missions" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/50 to-ink/30"></div>
    <!-- soft seam into the page below -->
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-20 sm:h-28"
      style="background:linear-gradient(to bottom, rgba(0,0,0,0) 0%, var(--color-fade) 96%)"
    >
    </div>
    <div class="relative mx-auto w-full max-w-7xl px-5 pb-24 pt-40 sm:px-8 sm:pb-28">
      <p class="max-w-4xl font-display text-3xl font-bold leading-[1.12] tracking-tight text-white sm:text-5xl lg:text-6xl">
        &ldquo;{missionsIntro.verse}&rdquo;
      </p>
      <p class="mt-6 text-sm font-medium uppercase tracking-[0.2em] text-white/70">{missionsIntro.reference}</p>
    </div>
  </section>

  <!-- Program -->
  <section class="fade-dark py-24 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="grid gap-8 lg:grid-cols-[280px_1fr] lg:gap-16">
        <div>
          <p class="eyebrow">{missionsIntro.season}</p>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">{missionsIntro.heading}</h2>
        </div>
        <div>
          <p class="max-w-2xl text-lg leading-relaxed text-white/70">{missionsIntro.body}</p>
          <p class="mt-8 font-display text-6xl font-bold tracking-tight text-white/10">{missionsIntro.hashtag}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Teams board -->
  <section class="border-b border-line bg-ink py-24 text-paper sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="eyebrow text-white/50">2026 STSM Teams</p>
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          teams.map((t) => (
            <a href={`#${t.slug}`} class="group relative aspect-[3/2] overflow-hidden rounded-2xl">
              <img src={t.cover} alt={t.country} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/20 to-transparent"></div>
              <div class="absolute bottom-0 left-0 p-5">
                <p class="text-xs uppercase tracking-[0.2em] text-white/60">{t.region}</p>
                <p class="font-display text-2xl font-bold tracking-tight text-white">{t.country}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Team detail sections -->
  {
    teams.map((t, idx) => (
      <section id={t.slug} class="scroll-mt-16 border-b border-line py-20 sm:py-24" class:list={[idx % 2 === 1 ? "bg-bone" : "bg-paper"]}>
        <div class="mx-auto max-w-7xl px-5 sm:px-8">
          <div class="flex items-end justify-between">
            <div>
              <p class="eyebrow">{t.region}</p>
              <h2 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">{t.country}</h2>
            </div>
          </div>
          {t.gallery.length > 0 ? (
            <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
              {t.gallery.map((src) => (
                <button
                  type="button"
                  data-lightbox={src}
                  class="reveal aspect-square overflow-hidden rounded-lg bg-bone"
                >
                  <img src={src} alt={`${t.country} missions`} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
                </button>
              ))}
            </div>
          ) : (
            <div class="mt-10 overflow-hidden rounded-2xl">
              <img src={t.cover} alt={t.country} loading="lazy" class="aspect-[3/2] w-full object-cover" />
            </div>
          )}
        </div>
      </section>
    ))
  }

  <!-- Give CTA -->
  <section class="bg-ink py-20 text-center text-paper">
    <div class="mx-auto max-w-xl px-5 sm:px-8">
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Support the sending.</h2>
      <p class="mt-3 text-white/70">Partner with KCM to send collegians to the nations.</p>
      <a href="/give" class="mt-7 inline-block rounded-full bg-white px-6 py-3 text-sm font-medium text-ink transition-transform hover:-translate-y-0.5">
        Give to KCM
      </a>
    </div>
  </section>

  <!-- Lightbox -->
  <div data-lb class="fixed inset-0 z-[60] hidden items-center justify-center bg-ink/95 p-6">
    <button data-lb-close aria-label="Close" class="absolute right-5 top-5 text-3xl text-white/80 hover:text-white">&times;</button>
    <img data-lb-img src="" alt="" class="max-h-[85vh] max-w-full rounded-lg object-contain" />
  </div>

  <script>
    const lb = document.querySelector<HTMLElement>("[data-lb]");
    const lbImg = document.querySelector<HTMLImageElement>("[data-lb-img]");
    const open = (src: string) => {
      if (!lb || !lbImg) return;
      lbImg.src = src;
      lb.classList.remove("hidden");
      lb.classList.add("flex");
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      if (!lb) return;
      lb.classList.add("hidden");
      lb.classList.remove("flex");
      document.body.style.overflow = "";
    };
    document.querySelectorAll<HTMLElement>("[data-lightbox]").forEach((el) =>
      el.addEventListener("click", () => open(el.dataset.lightbox!))
    );
    lb?.addEventListener("click", (e) => {
      if (e.target === lb || (e.target as HTMLElement).hasAttribute("data-lb-close")) close();
    });
    document.addEventListener("keydown", (e) => e.key === "Escape" && close());
  </script>
</Layout>
